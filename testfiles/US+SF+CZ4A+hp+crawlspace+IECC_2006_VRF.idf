    -0.00972,                !- Coefficient4 y
    -2.14e-05,               !- Coefficient5 y**2
    -0.000686,               !- Coefficient6 x*y
    0.0,                     !- Minimum Value of x
    100.0,                   !- Maximum Value of x
    0.0,                     !- Minimum Value of y
    100.0;                   !- Maximum Value of y

  Curve:Quadratic,
