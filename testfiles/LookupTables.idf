    Constant,                !- Extrapolation Method
    0.0,                     !- Minimum Value
    1.0,                     !- Maximum Value
    ,                        !- Normalization Reference Value
    Dimensionless,           !- Unit Type
    ,                        !- External File Name
    ,                        !- External File Column Number
    ,                        !- External File Starting Row Number
    0.0,                     !- Value 1
    0.5,                     !- Value 2
    1.0;                     !- Value 3

