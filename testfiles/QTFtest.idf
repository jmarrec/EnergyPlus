    15.24,0.0,0.0,  !- X,Y,Z ==> Vertex 2 {m}
    15.24,15.24,0.0,  !- X,Y,Z ==> Vertex 3 {m}
    15.24,15.24,4.572;  !- X,Y,Z ==> Vertex 4 {m}

  BuildingSurface:Detailed,
    Zn001:Wall003,           !- Name
