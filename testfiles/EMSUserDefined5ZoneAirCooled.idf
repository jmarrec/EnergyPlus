EnergyManagementSystem:Program,
  InitMainSimpleCoilModel,  !- Name
  Set CWLoopExitTemp = 7.0,  !- Program Line 1
  Set CWLoopDeltaTemp = 4.0,  !- Program Line 2
  Set CW_CP = @CPCW CWLoopExitTemp,  !- Program Line 3
  Set CW_rho = @RhoH2O CWLoopExitTemp,  !- Program Line 4
  Set CWcoil1_Water_DesignVdot = Sys1_CoolDes_Qdot / (( CW_rho * CW_CP) * CWLoopDeltaTemp),  !- Program Line 5
  Set CWcoil1_Mdot_Min = 0.0,  !- Program Line 6
  Set CWcoil1_Mdot_Max = CWcoil1_Water_DesignVdot * CW_rho;  !- Program Line 7

