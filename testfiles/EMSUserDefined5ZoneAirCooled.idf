  Central Chiller Condenser Outlet Node,  !- Air Connection Outlet Node Name
  ,                        !- Supply Inlet Water Storage Tank Name
  ,                        !- Collection Outlet Water Storage Tank Name
  ;                        !- Ambient Zone Name

EnergyManagementSystem:ProgramCallingManager,
  Chiller model simulation programs,  !- Name
  UserDefinedComponentModel,  !- EnergyPlus Model Calling Point
  ModelChillerModel;       !- Program Name 1

EnergyManagementSystem:Program,
  ModelChillerModel,       !- Name
  Set dummy = CW_MyLoad,   !- Program Line 1
  Set dummy = CW_Tin,      !- Program Line 2
  Set dummy = CW_Mdot,     !- Program Line 3
  If CW_MyLoad > (0 - 100),  !- Program Line 4
  Set CW_Tout             = CW_Tin,  !- Program Line 5
  Set CW_Mdot_Request     = 0.0,  !- Program Line 6
  Set Chiller_ElectEnergy = 0.0,  !- Program Line 7
  RETURN,                  !- Program Line 8
  ENDIF,                   !- Program Line 9
  Set ABS_CW_MyLoad = @ABS CW_MyLoad,  !- Program Line 10
  IF ABS_CW_MyLoad > Chiller_Cap_Max,  !- Program Line 11
  Set Qdot = Chiller_Cap_Max,  !- Program Line 12
  ELSE,                    !- Program Line 13
  Set Qdot = ABS_CW_MyLoad,  !- Program Line 14
  ENDIF,                   !- Program Line 15
  IF CW_Mdot == 0,         !- Program Line 16
  Set Mdot = Chiller_Mdot_Max,  !- Program Line 17
  SEt CW_Mdot_Request = Chiller_Mdot_Max,  !- Program Line 18
  ELSE,                    !- Program Line 19
  Set Mdot = CW_Mdot,      !- Program Line 20
  ENDIF,                   !- Program Line 21
  Set CW_Tout = CW_Tin - (Qdot / (Mdot * CW_Cp)),  !- Program Line 22
  Set EIR     = 1 / 4.6,   !- Program Line 23
  Set Chiller_power = Qdot * EIR,  !- Program Line 24
  Set Chiller_ElectEnergy = Chiller_power * SystemTimestep * 3600;  !- Program Line 25

EnergyManagementSystem:ProgramCallingManager,
  Chiller model init programs,  !- Name
  UserDefinedComponentModel,  !- EnergyPlus Model Calling Point
  InitEvapChillerModel;    !- Program Name 1

EnergyManagementSystem:Program,
  InitEvapChillerModel,    !- Name
  Set CWLoopExitTemp = 7.0,  !- Program Line 1
  Set CWLoopDeltaTemp = 4.0,  !- Program Line 2
  Set CW_CP = @CPCW CWLoopExitTemp,  !- Program Line 3
  Set CW_rho = @RhoH2O CWLoopExitTemp,  !- Program Line 4
  Set Chiller_Vdot_Design = CWplant_Vdot_Design,  !- Program Line 5
  Set Chiller_Mdot_Min = 0.0,  !- Program Line 6
  Set Chiller_Mdot_Max = Chiller_Vdot_Design * CW_rho,  !- Program Line 7
  Set Chiller_Cap = CW_CP * CW_rho * CWLoopDeltaTemp * CWplant_Vdot_Design,  !- Program Line 8
  Set Chiller_Cap_Min = 0.0,  !- Program Line 9
  Set Chiller_Cap_Max = Chiller_Cap,  !- Program Line 10
  Set Chiller_Cap_Opt = 0.9 * Chiller_Cap;  !- Program Line 11

