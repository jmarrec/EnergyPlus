  UserDefinedComponentModel,  !- EnergyPlus Model Calling Point
  Space5ATU_ModelInput,    !- Program Name 1
  ATU_Sim_Model,           !- Program Name 2
  Space5ATU_ModelOutput;   !- Program Name 3

EnergyManagementSystem:Program,
  Space5ATU_ModelInput,    !- Name
  Set DeckAir_Tinlet    = Space5ATU_PrimAir_Tinlet,  !- Program Line 1
  Set DeckAir_Winlet    = Space5ATU_PrimAir_Winlet,  !- Program Line 2
  Set Zone_T            = Space5_Tdb,  !- Program Line 3
  Set Zone_W            = Space5_W,  !- Program Line 4
  Set Zone_Tsp_Cool     = Space5_Tsp_cool,  !- Program Line 5
  Set Zone_Tsp_Heat     = Space5_Tsp_heat,  !- Program Line 6
  Set AirSupMdotDesign  = Space5ATU_DesignAirMdot,  !- Program Line 7
  Set DamperMin         = 0.3,  !- Program Line 8
  Set Qdot_Req_toCoolSP = Space5ATU_Qdot_ToCoolSP,  !- Program Line 9
  Set Qdot_Req_toHeatSP = Space5ATU_Qdot_ToHeatSP,  !- Program Line 10
  Set HWCoil_Mdot_Max   = Space5ATU_HW_MdotMax,  !- Program Line 11
  Set HW_Tin            = Space5ATU_HW_Tin,  !- Program Line 12
  Set HW_Cp             = Space5ATU_HW_cp,  !- Program Line 13
  Set HWCoil_Eff        = 0.7,  !- Program Line 14
  Set HWCoil_Mdot       = Space5ATU_HW_MdotIn;  !- Program Line 15

EnergyManagementSystem:Program,
  Space5ATU_ModelOutput,   !- Name
  Set Space5ATU_PrimAir_Tout = Air_Tout,  !- Program Line 1
  Set Space5ATU_PrimAir_Wout = Air_Wout,  !- Program Line 2
  Set Space5ATU_PrimAir_MdotOut = Air_MdotOut,  !- Program Line 3
  Set Space5ATU_PrimAir_MdotIn = Air_MdotOut,  !- Program Line 4
  Set Space5ATU_tot_heat_Power = HWCoil_heat_Power,  !- Program Line 5
  SEt Space5ATU_HW_MdotRequest = HW_MdotRequest,  !- Program Line 6
  Set Space5ATU_HW_Tout = HW_Tout;  !- Program Line 7

!end terminal
!
!unload HW coil model results
! run at full damper open (for good zone air mixing) and
!unload HW coil model results
!unload HW coil model results

EnergyManagementSystem:Program,
  ATU_Sim_Model,           !- Name
  IF (ATU_Avail_Sched == 0.0),  !- Program Line 1
  Set Air_MdotOut     = 0.0,  !- Program Line 2
  Set HW_MdotRequest  = 0.0,  !- Program Line 3
  Set HW_Tout    = HW_Tin,  !- Program Line 4
  Set HWCoil_heat_Power    = 0.0,  !- Program Line 5
  Set Air_Tout             = DeckAir_Tinlet,  !- Program Line 6
  Set Air_Wout             = DeckAir_Winlet,  !- Program Line 7
  Set DamperPosition = DamperMin,  !- Program Line 8
  RETURN,                  !- Program Line 9
  ENDIF,                   !- Program Line 10
  Set Zone_H = @HFnTdbW Zone_T Zone_W,  !- Program Line 11
  Set Zone_H_AtCoolSp = @HFnTdbW Zone_Tsp_Cool Zone_W,  !- Program Line 12
  Set Zone_H_AtHeatSp = @HFnTdbW Zone_Tsp_Heat Zone_W,  !- Program Line 13
  Set SupAir_H = @HFnTdbW DeckAir_Tinlet DeckAir_Winlet,  !- Program Line 14
  IF Qdot_Req_toCoolSP < (0 - 10.0),  !- Program Line 15
  Set ABS_Qdot_Cool = @ABS Qdot_Req_toCoolSP,  !- Program Line 16
  Set Air_Mdot = ABS_Qdot_Cool / (Zone_H_AtCoolSp - SupAir_H),  !- Program Line 17
  Set Air_Mdot = @MIN AirSupMdotDesign Air_Mdot,  !- Program Line 18
  Set DamperPosition = Air_Mdot / AirSupMdotDesign,  !- Program Line 19
  IF DamperPosition < DamperMin,  !- Program Line 20
  Set Air_Mdot = DamperMin * AirSupMdotDesign,  !- Program Line 21
  Set HoutDesired = Zone_H_AtHeatSp - ABS_Qdot_Cool/Air_Mdot,  !- Program Line 22
  Set Air_Tsp = @TdbFnHW HoutDesired DeckAir_Winlet,  !- Program Line 23
  Set Water_Mdot    = HWCoil_Mdot,  !- Program Line 24
  Set Air_Tinlet    = DeckAir_Tinlet,  !- Program Line 25
  Set Air_Winlet    = DeckAir_Winlet,  !- Program Line 26
  Set Water_Tinlet  = HW_Tin,  !- Program Line 27
  Set Coil_Eff      = HWCoil_Eff,  !- Program Line 28
  Set Water_Mdot_Max = HWCoil_Mdot_Max,  !- Program Line 29
  Set Water_cp       = HW_Cp,  !- Program Line 30
  RUN HW_Coil_Sim_Model,   !- Program Line 31
  Set HW_MdotRequest      = Water_MdotRequest,  !- Program Line 32
  Set Air_Tout            = Air_Tout,  !- Program Line 33
  Set Air_Wout            = Air_Wout,  !- Program Line 34
  Set HWCoil_heat_Power   = Tot_heat_Power,  !- Program Line 35
  Set HW_Tout   = Water_Tout,  !- Program Line 36
  ELSE,                    !- Program Line 37
  Set HW_MdotRequest       = 0.0,  !- Program Line 38
  Set Air_Tout             = DeckAir_Tinlet,  !- Program Line 39
  Set Air_Wout             = DeckAir_Winlet,  !- Program Line 40
  Set HWCoil_heat_Power    = 0.0,  !- Program Line 41
  Set HW_Tout    = HW_Tin,  !- Program Line 42
  Set Air_MdotOut = Air_Mdot,  !- Program Line 43
  ENDIF,                   !- Program Line 44
  ELSEIF Qdot_Req_toHeatSP > 10.0,  !- Program Line 45
  Set DamperPosition = 1.0,  !- Program Line 46
  Set Air_Mdot = AirSupMdotDesign,  !- Program Line 47
  Set ABS_Qdot_heat = @ABS Qdot_Req_toHeatSP,  !- Program Line 48
  Set HoutDesired   = Zone_H_AtHeatSp + ABS_Qdot_Heat/Air_Mdot,  !- Program Line 49
  Set Air_Tsp = @TdbFnHW HoutDesired DeckAir_Winlet,  !- Program Line 50
  Set Water_Mdot    = HWCoil_Mdot,  !- Program Line 51
  Set Air_Tinlet    = DeckAir_Tinlet,  !- Program Line 52
  Set Air_Winlet    = DeckAir_Winlet,  !- Program Line 53
  Set Water_Tinlet  = HW_Tin,  !- Program Line 54
  Set Coil_Eff      = HWCoil_Eff,  !- Program Line 55
  Set Water_Mdot_Max = HWCoil_Mdot_Max,  !- Program Line 56
  Set Water_cp       = HW_Cp,  !- Program Line 57
  RUN HW_Coil_Sim_Model,   !- Program Line 58
  Set HW_MdotRequest      = Water_MdotRequest,  !- Program Line 59
  Set Air_Tout            = Air_Tout,  !- Program Line 60
  Set Air_Wout            = Air_Wout,  !- Program Line 61
  Set HWCoil_heat_Power   = Tot_heat_Power,  !- Program Line 62
  Set HW_Tout   = Water_Tout,  !- Program Line 63
  ELSE,                    !- Program Line 64
  Set DamperPosition = DamperMin,  !- Program Line 65
  Set Air_Mdot = DamperPosition * AirSupMdotDesign,  !- Program Line 66
  Set HoutDesired   = Zone_H_AtHeatSp,  !- Program Line 67
  Set Air_Tsp = @TdbFnHW HoutDesired DeckAir_Winlet,  !- Program Line 68
  Set Air_Tinlet    = DeckAir_Tinlet,  !- Program Line 69
  Set Air_Winlet    = DeckAir_Winlet,  !- Program Line 70
  Set Water_Tinlet  = HW_Tin,  !- Program Line 71
  Set Coil_Eff      = HWCoil_Eff,  !- Program Line 72
  Set Water_Mdot_Max = HWCoil_Mdot_Max,  !- Program Line 73
  Set Water_cp       = HW_Cp,  !- Program Line 74
  RUN HW_Coil_Sim_Model,   !- Program Line 75
  Set HW_MdotRequest      = Water_MdotRequest,  !- Program Line 76
  Set Air_Tout            = Air_Tout,  !- Program Line 77
  Set Air_Wout            = Air_Wout,  !- Program Line 78
  Set HWCoil_heat_Power   = Tot_heat_Power,  !- Program Line 79
  Set HW_Tout   = Water_Tout,  !- Program Line 80
  ENDIF,                   !- Program Line 81
  Set Air_MdotOut = Air_Mdot;  !- Program Line 82

EnergyManagementSystem:Program,
  HW_Coil_Sim_Model,       !- Name
  IF Air_Mdot == 0.0,      !- Program Line 1
  SET Air_Tout = Air_Tinlet,  !- Program Line 2
  SET Air_Wout = Air_Winlet,  !- Program Line 3
  Set Air_MdotOut = Air_Mdot,  !- Program Line 4
  Set tot_heat_Power = 0.0,  !- Program Line 5
  Set Water_Tout = Water_Tinlet,  !- Program Line 6
  Set Water_MdotRequest = 0.0,  !- Program Line 7
  RETURN,                  !- Program Line 8
  ENDIF,                   !- Program Line 9
  IF Air_Tinlet > Air_Tsp,  !- Program Line 10
  SET Air_Tout          = Air_Tinlet,  !- Program Line 11
  SET Air_Wout          = Air_Winlet,  !- Program Line 12
  Set Air_MdotOut       = Air_Mdot,  !- Program Line 13
  Set tot_heat_Power    = 0.0,  !- Program Line 14
  Set Water_Tout        = Water_Tinlet,  !- Program Line 15
  Set Water_MdotRequest = 0.0,  !- Program Line 16
  RETURN,                  !- Program Line 17
  ENDIF,                   !- Program Line 18
  Set AirIn_Enth     = @HFnTdbW Air_Tinlet Air_Winlet,  !- Program Line 19
  Set AirOut_Enth_Limit = @HFnTdbW Water_Tinlet Air_Winlet,  !- Program Line 20
  Set MaxQdot      = Coil_Eff * Air_Mdot * (AirOut_Enth_Limit - AirIn_Enth ),  !- Program Line 21
  IF MaxQdot <= 0.0,       !- Program Line 22
  SET Air_Tout          = Air_Tinlet,  !- Program Line 23
  SET Air_Wout          = Air_Winlet,  !- Program Line 24
  Set Air_MdotOut       = Air_Mdot,  !- Program Line 25
  Set tot_heat_Power    = 0.0,  !- Program Line 26
  Set Water_Tout        = Water_Tinlet,  !- Program Line 27
  Set Water_MdotRequest = 0.0,  !- Program Line 28
  RETURN,                  !- Program Line 29
  ENDIF,                   !- Program Line 30
  Set Air_Wout = Air_Winlet,  !- Program Line 31
  Set Air_HoutSP = @HFnTdbW Air_Tsp Air_Wout,  !- Program Line 32
  Set Qdot_SP    = Air_Mdot * (Air_HoutSP - AirIn_Enth ),  !- Program Line 33
  IF Qdot_SP > MaxQdot,    !- Program Line 34
  Set Air_Hout = AirIn_Enth + (MaxQdot/Air_Mdot),  !- Program Line 35
  ELSE,                    !- Program Line 36
  Set Air_Hout = Air_HoutSP,  !- Program Line 37
  ENDIF,                   !- Program Line 38
  Set Air_Tout = @TdbFnHW Air_Hout Air_Wout,  !- Program Line 39
  Set ActualQdot  = Air_Mdot * (Air_Hout - AirIn_Enth),  !- Program Line 40
  Set Water_partLoad = ActualQdot / MaxQdot,  !- Program Line 41
  Set Water_MdotRequest = Water_Mdot_Max * Water_PartLoad,  !- Program Line 42
  Set HW_tempFall = ActualQdot/(Water_MdotRequest * Water_cp),  !- Program Line 43
  Set Water_Tout = Water_Tinlet - HW_tempFall,  !- Program Line 44
  Set tot_heat_Power = ActualQdot;  !- Program Line 45
