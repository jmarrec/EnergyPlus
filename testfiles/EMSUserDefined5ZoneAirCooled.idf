EnergyManagementSystem:ProgramCallingManager,
  OA Cooling Coil Model Program Manager,  !- Name
  UserDefinedComponentModel,  !- EnergyPlus Model Calling Point
  OA_CWCoil_ModelInput,    !- Program Name 1
  CW_Coil_Sim_Model,       !- Program Name 2
  OA_CWCoil_ModelOuput;    !- Program Name 3

EnergyManagementSystem:Program,
  OA_CWCoil_ModelInput,    !- Name
  Set Air_Mdot       = OACoil_Air_Mdot,  !- Program Line 1
  Set Air_Tsp        = OACoil_Air_Tsp,  !- Program Line 2
  Set Water_Mdot     = OACoil_Water_Mdot,  !- Program Line 3
  Set Water_cp       = OACoil_Water_cp,  !- Program Line 4
  Set Air_Tinlet     = OACoil_Air_Tinlet,  !- Program Line 5
  Set Water_Tinlet   = OACoil_Water_Tinlet,  !- Program Line 6
  Set Air_Winlet     = OACoil_Air_Winlet,  !- Program Line 7
  Set Water_Mdot_Max = OACoil_Mdot_Max,  !- Program Line 8
  Set Coil_Eff       = 0.68;  !- Program Line 9

EnergyManagementSystem:Program,
  OA_CWCoil_ModelOuput,    !- Name
  Set OACoil_Water_MdotRequest = Water_MdotRequest,  !- Program Line 1
  Set OACoil_Air_Tout          = Air_Tout,  !- Program Line 2
  Set OACoil_Air_Wout          = Air_Wout,  !- Program Line 3
  Set OACoil_tot_cool_Power    = Tot_Cool_Power,  !- Program Line 4
  Set OACoil_tot_cool_Energy   = Tot_Cool_Power * SystemTimestep * 3600,  !- Program Line 5
  Set OACoil_Air_MdotOut       = Air_Mdot,  !- Program Line 6
  Set OACoil_Water_Tout        = Water_Tout;  !- Program Line 7

EnergyManagementSystem:ProgramCallingManager,
  OA Cooling Coil Init Program Manager,  !- Name
  UserDefinedComponentModel,  !- EnergyPlus Model Calling Point
  InitOASimpleCoilModel;   !- Program Name 1

EnergyManagementSystem:Program,
  InitOASimpleCoilModel,   !- Name
  Set CWLoopExitTemp = 7.0,  !- Program Line 1
  Set CWLoopDeltaTemp = 0.5 * 4.0,  !- Program Line 2
  Set CW_CP = @CPCW CWLoopExitTemp,  !- Program Line 3
  Set CW_rho = @RhoH2O CWLoopExitTemp,  !- Program Line 4
  Set Dummy = OA_Design_Tdb,  !- Program Line 5
  Set Dummy = OA_Design_W,  !- Program Line 6
  Set Dummy = OA_Design_Vdot,  !- Program Line 7
  Set Houtdoor = @HFnTdbW OA_Design_Tdb OA_Design_W,  !- Program Line 8
  Set OA_rho = @RhoAirFnPbTdbW OA_Press OA_Design_Tdb OA_Design_W,  !- Program Line 9
  Set OA_mdot = OA_Design_Vdot * OA_rho,  !- Program Line 10
  Set Hleaving = @HFnTdbW 11.0 0.008,  !- Program Line 11
  Set OACoil_CoolDes_Qdot = OA_mdot * ( Houtdoor - Hleaving),  !- Program Line 12
  Set OACoil_Water_DesignVdot = OACoil_CoolDes_Qdot / (( CW_rho * CW_CP) * CWLoopDeltaTemp),  !- Program Line 13
  Set OACoil_Mdot_Min = 0.0,  !- Program Line 14
  Set OACoil_Mdot_Max = OACoil_Water_DesignVdot * CW_rho;  !- Program Line 15

