EnergyManagementSystem:ProgramCallingManager,
  Space4 ATU Init Programs,  !- Name
  UserDefinedComponentModel,  !- EnergyPlus Model Calling Point
  InitSpace4ATU;           !- Program Name 1

EnergyManagementSystem:Program,
  InitSpace4ATU,           !- Name
  Set Space4ATU_DesignAirMdot = @MAX Space4ATU_HeatAirMdot Space4ATU_CoolAirMdot,  !- Program Line 1
  Set HWLoopExitTemp = 82.0,  !- Program Line 2
  Set HWLoopDeltaTemp = 11.0,  !- Program Line 3
  Set HW_CP = @CPCW HWLoopExitTemp,  !- Program Line 4
  Set HW_rho = @RhoH2O HWLoopExitTemp,  !- Program Line 5
  Set HeatCentralSAT = 16.7,  !- Program Line 6
  Set HeatZoneSAT    = 50.0,  !- Program Line 7
  Set AvgSAT = (HeatCentralSAT + HeatZoneSAT) / 2,  !- Program Line 8
  Set HeatingZoneW      = 0.004,  !- Program Line 9
  Set HeatingAir_CP     = @CpAirFnW HeatingZoneW,  !- Program Line 10
  Set HWCoil_DesLoad = (HeatingAir_CP * Space4ATU_DesignAirMdot) * (HeatZoneSAT - HeatCentralSAT),  !- Program Line 11
  Set Space4ATU_HW_DesignVdot = HWCoil_DesLoad / (( HW_rho * HW_CP) * HWLoopDeltaTemp),  !- Program Line 12
  Set Space4ATU_HW_MdotMin = 0.0,  !- Program Line 13
  Set Space4ATU_HW_MdotMax = Space4ATU_HW_DesignVdot * HW_rho;  !- Program Line 14

EnergyManagementSystem:ProgramCallingManager,
  Space4 ATU Sim Programs,  !- Name
  UserDefinedComponentModel,  !- EnergyPlus Model Calling Point
  Space4ATU_ModelInput,    !- Program Name 1
  ATU_Sim_Model,           !- Program Name 2
  Space4ATU_ModelOutput;   !- Program Name 3

EnergyManagementSystem:Program,
  Space4ATU_ModelInput,    !- Name
  Set DeckAir_Tinlet    = Space4ATU_PrimAir_Tinlet,  !- Program Line 1
  Set DeckAir_Winlet    = Space4ATU_PrimAir_Winlet,  !- Program Line 2
  Set Zone_T            = Space4_Tdb,  !- Program Line 3
  Set Zone_W            = Space4_W,  !- Program Line 4
  Set Zone_Tsp_Cool     = Space4_Tsp_cool,  !- Program Line 5
  Set Zone_Tsp_Heat     = Space4_Tsp_heat,  !- Program Line 6
  Set AirSupMdotDesign  = Space4ATU_DesignAirMdot,  !- Program Line 7
  Set DamperMin         = 0.3,  !- Program Line 8
  Set Qdot_Req_toCoolSP = Space4ATU_Qdot_ToCoolSP,  !- Program Line 9
  Set Qdot_Req_toHeatSP = Space4ATU_Qdot_ToHeatSP,  !- Program Line 10
  Set HWCoil_Mdot_Max   = Space4ATU_HW_MdotMax,  !- Program Line 11
  Set HW_Tin            = Space4ATU_HW_Tin,  !- Program Line 12
  Set HW_Cp             = Space4ATU_HW_cp,  !- Program Line 13
  Set HWCoil_Eff        = 0.7,  !- Program Line 14
  Set HWCoil_Mdot       = Space4ATU_HW_MdotIn;  !- Program Line 15

EnergyManagementSystem:Program,
  Space4ATU_ModelOutput,   !- Name
  Set Space4ATU_PrimAir_Tout = Air_Tout,  !- Program Line 1
  Set Space4ATU_PrimAir_Wout = Air_Wout,  !- Program Line 2
  Set Space4ATU_PrimAir_MdotOut = Air_MdotOut,  !- Program Line 3
  Set Space4ATU_PrimAir_MdotIn = Air_MdotOut,  !- Program Line 4
  Set Space4ATU_tot_heat_Power = HWCoil_heat_Power,  !- Program Line 5
  SEt Space4ATU_HW_MdotRequest = HW_MdotRequest,  !- Program Line 6
  Set Space4ATU_HW_Tout = HW_Tout;  !- Program Line 7

