EnergyManagementSystem:ProgramCallingManager,
  Space1 ATU Init Programs,  !- Name
  UserDefinedComponentModel,  !- EnergyPlus Model Calling Point
  InitSpace1ATU;           !- Program Name 1

EnergyManagementSystem:Program,
  InitSpace1ATU,           !- Name
  Set Space1ATU_DesignAirMdot = @MAX Space1ATU_HeatAirMdot Space1ATU_CoolAirMdot,  !- Program Line 1
  Set HWLoopExitTemp = 82.0,  !- Program Line 2
  Set HWLoopDeltaTemp = 11.0,  !- Program Line 3
  Set HW_CP = @CPCW HWLoopExitTemp,  !- Program Line 4
  Set HW_rho = @RhoH2O HWLoopExitTemp,  !- Program Line 5
  Set HeatCentralSAT = 16.7,  !- Program Line 6
  Set HeatZoneSAT    = 50.0,  !- Program Line 7
  Set AvgSAT = (HeatCentralSAT + HeatZoneSAT) / 2,  !- Program Line 8
  Set HeatingZoneW      = 0.004,  !- Program Line 9
  Set HeatingAir_CP     = @CpAirFnW HeatingZoneW,  !- Program Line 10
  Set HWCoil_DesLoad = (HeatingAir_CP * Space1ATU_DesignAirMdot) * (HeatZoneSAT - HeatCentralSAT),  !- Program Line 11
  Set Space1ATU_HW_DesignVdot = HWCoil_DesLoad / (( HW_rho * HW_CP) * HWLoopDeltaTemp),  !- Program Line 12
  Set Space1ATU_HW_MdotMin = 0.0,  !- Program Line 13
  Set Space1ATU_HW_MdotMax = Space1ATU_HW_DesignVdot * HW_rho;  !- Program Line 14

EnergyManagementSystem:ProgramCallingManager,
  Space1 ATU Sim Programs,  !- Name
  UserDefinedComponentModel,  !- EnergyPlus Model Calling Point
  Space1ATU_ModelInput,    !- Program Name 1
  ATU_Sim_Model,           !- Program Name 2
  Space1ATU_ModelOutput;   !- Program Name 3

EnergyManagementSystem:Program,
  Space1ATU_ModelInput,    !- Name
  Set DeckAir_Tinlet    = Space1ATU_PrimAir_Tinlet,  !- Program Line 1
  Set DeckAir_Winlet    = Space1ATU_PrimAir_Winlet,  !- Program Line 2
  Set Zone_T            = Space1_Tdb,  !- Program Line 3
  Set Zone_W            = Space1_W,  !- Program Line 4
  Set Zone_Tsp_Cool     = Space1_Tsp_cool,  !- Program Line 5
  Set Zone_Tsp_Heat     = Space1_Tsp_heat,  !- Program Line 6
  Set AirSupMdotDesign  = Space1ATU_DesignAirMdot,  !- Program Line 7
  Set DamperMin         = 0.3,  !- Program Line 8
  Set Qdot_Req_toCoolSP = Space1ATU_Qdot_ToCoolSP,  !- Program Line 9
