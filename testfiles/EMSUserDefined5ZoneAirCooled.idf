  CW_Coil_Sim_Model,       !- Program Name 2
  MainCWCoil1_ModelOuput;  !- Program Name 3

EnergyManagementSystem:Program,
  MainCWCoil1_ModelInput,  !- Name
  Set Air_Mdot       = CWcoil1_Air_Mdot,  !- Program Line 1
  Set Air_Tsp        = CWcoil1_Air_Tsp,  !- Program Line 2
  Set Water_Mdot     = CWcoil1_Water_Mdot,  !- Program Line 3
  Set Water_cp       = CWcoil1_Water_cp,  !- Program Line 4
  SEt Air_Tinlet     = CWcoil1_Air_Tinlet,  !- Program Line 5
  Set Water_Tinlet   = CWcoil1_Water_Tinlet,  !- Program Line 6
  SEt Air_Winlet     = CWcoil1_Air_Winlet,  !- Program Line 7
  Set Water_Mdot_Max = CWcoil1_Mdot_Max,  !- Program Line 8
  Set Coil_Eff       = 0.7;  !- Program Line 9

EnergyManagementSystem:Program,
  MainCWCoil1_ModelOuput,  !- Name
  Set CWcoil1_Water_MdotRequest = Water_MdotRequest,  !- Program Line 1
  Set CWcoil1_Air_Tout          = Air_Tout,  !- Program Line 2
  Set CWcoil1_Air_Wout          = Air_Wout,  !- Program Line 3
  Set CWcoil1_tot_cool_Power    = Tot_Cool_Power,  !- Program Line 4
  Set CWcoil1_tot_cool_Energy   = Tot_Cool_Power * SystemTimestep * 3600,  !- Program Line 5
  Set CWcoil1_Air_MdotOut       = Air_Mdot,  !- Program Line 6
  Set CWcoil1_Water_Tout        = Water_Tout;  !- Program Line 7

EnergyManagementSystem:GlobalVariable,
  Air_Mdot,                !- Erl Variable 1 Name
  Air_Tsp,                 !- Erl Variable 2 Name
  Water_Mdot,              !- Erl Variable 3 Name
  Water_cp,                !- Erl Variable 4 Name
  Air_Tinlet,              !- Erl Variable 5 Name
  Water_Tinlet,            !- Erl Variable 6 Name
  Air_Winlet,              !- Erl Variable 7 Name
  Water_Mdot_Max,          !- Erl Variable 8 Name
  Coil_Eff,                !- Erl Variable 9 Name
  Water_MdotRequest,       !- Erl Variable 10 Name
  Air_Tout,                !- Erl Variable 11 Name
  Tot_Cool_Power,          !- Erl Variable 12 Name
  Air_Wout,                !- Erl Variable 13 Name
  Water_Tout;              !- Erl Variable 14 Name

EnergyManagementSystem:Program,
  CW_Coil_Sim_Model,       !- Name
  IF Air_Mdot == 0.0,      !- Program Line 1
  SET Air_Tout = Air_Tinlet,  !- Program Line 2
  SET Air_Wout = Air_Winlet,  !- Program Line 3
  Set Air_MdotOut = Air_Mdot,  !- Program Line 4
  Set tot_cool_Power = 0.0,  !- Program Line 5
  Set Water_Tout = Water_Tinlet,  !- Program Line 6
  Set Water_MdotRequest = 0.0,  !- Program Line 7
  RETURN,                  !- Program Line 8
  ENDIF,                   !- Program Line 9
  Set AirIn_Enth     = @HFnTdbW Air_Tinlet Air_Winlet,  !- Program Line 10
  Set Air_Wout_Limit = @WFnTdbRhPb Water_Tinlet 1 OA_Press,  !- Program Line 11
  Set AirOut_Enth_Limit = @HFnTdbW Water_Tinlet Air_Wout_Limit,  !- Program Line 12
  Set MaxQdot      = Coil_Eff * Air_Mdot * (AirIn_Enth - AirOut_Enth_Limit),  !- Program Line 13
  IF MaxQdot <= 0.0,       !- Program Line 14
  SET Air_Tout          = Air_Tinlet,  !- Program Line 15
  SET Air_Wout          = Air_Winlet,  !- Program Line 16
  Set Air_MdotOut       = Air_Mdot,  !- Program Line 17
  Set tot_cool_Power    = 0.0,  !- Program Line 18
  Set Water_Tout        = Water_Tinlet,  !- Program Line 19
  Set Water_MdotRequest = 0.0,  !- Program Line 20
  RETURN,                  !- Program Line 21
  ENDIF,                   !- Program Line 22
  Set AirIn_dewpoint = @TdpFnWpb Air_Winlet OA_Press,  !- Program Line 23
  IF  AirIn_dewpoint < Air_Tsp,  !- Program Line 24
  Set Air_Wout = Air_Winlet,  !- Program Line 25
  Set Air_HoutSP = @HFnTdbW Air_Tsp Air_Wout,  !- Program Line 26
  Set Qdot_SP    = Air_Mdot * (AirIn_Enth - Air_HoutSP),  !- Program Line 27
  IF Qdot_SP > MaxQdot,    !- Program Line 28
  Set Air_Hout = AirIn_Enth - (MaxQdot/Air_Mdot),  !- Program Line 29
  ELSE,                    !- Program Line 30
  Set Air_Hout = Air_HoutSP,  !- Program Line 31
  ENDIF,                   !- Program Line 32
  ELSEIF AirIn_dewpoint > Air_Tsp,  !- Program Line 33
  Set Air_WoutSP = @WFnTdbRhPb Air_Tsp 1 OA_Press,  !- Program Line 34
  Set Air_HoutSP = @HFnTdbW Air_Tsp Air_WoutSP,  !- Program Line 35
  Set Qdot_SP    = Air_Mdot * (AirIn_Enth - Air_HoutSP),  !- Program Line 36
  IF Qdot_SP > MaxQdot,    !- Program Line 37
  set Air_Hout = AirIn_Enth - (MaxQdot/Air_Mdot),  !- Program Line 38
  set Air_Tsat = @TsatFnHPb Air_Hout OA_Press,  !- Program Line 39
  SEt Air_Wout = @WFnTdbRhPb Air_Tsat 1 OA_Press,  !- Program Line 40
  ELSE,                    !- Program Line 41
  set Air_Hout = Air_HoutSP,  !- Program Line 42
  SEt Air_Wout = Air_WoutSP,  !- Program Line 43
  ENDIF,                   !- Program Line 44
  ENDIF,                   !- Program Line 45
  Set Air_Tout = @TdbFnHW Air_Hout Air_Wout,  !- Program Line 46
  Set ActualQdot  = Air_Mdot * (AirIn_Enth   - Air_Hout),  !- Program Line 47
  Set Water_partLoad = ActualQdot / MaxQdot,  !- Program Line 48
  Set Water_MdotRequest = Water_Mdot_Max * Water_PartLoad,  !- Program Line 49
  IF (Water_Mdot > 0.0),   !- Program Line 50
  Set CW_tempRise = ActualQdot/(Water_Mdot * Water_cp),  !- Program Line 51
  ELSE,                    !- Program Line 52
  Set CW_tempRise = ActualQdot/(Water_MdotRequest * Water_cp),  !- Program Line 53
  ENDIF,                   !- Program Line 54
  Set Water_Tout = Water_Tinlet + CW_tempRise,  !- Program Line 55
  Set tot_cool_Power = ActualQdot;  !- Program Line 56

EnergyManagementSystem:ProgramCallingManager,
