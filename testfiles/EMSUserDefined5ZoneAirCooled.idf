  OACoil_tot_cool_Power,   !- EMS Variable Name
  Averaged,                !- Type of Data in Variable
  SystemTimestep,          !- Update Frequency
  Oa_CWCoil_ModelOuput,    !- EMS Program or Subroutine Name
  W;                       !- Units

