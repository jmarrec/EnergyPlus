    HeatSys1 Operation Scheme,  !- Name
    0.0,                     !- Load Range 1 Lower Limit {W}
    1000000000000000.0,      !- Load Range 1 Upper Limit {W}
    HeatSys1 Equipment List;  !- Range 1 Equipment List Name

