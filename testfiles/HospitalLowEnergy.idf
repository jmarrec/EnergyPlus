  EnergyManagementSystem:ProgramCallingManager,
    CondenserLoopScheduleSelectorCallingManager,  !- Name
    BeginTimestepBeforePredictor,  !- EnergyPlus Model Calling Point
    CondenserLoopScheduleSelector;  !- Program Name 1

  EnergyManagementSystem:Program,
    CondenserLoopScheduleSelector,  !- Name
    IF CondenserLoopInletTempSensor >= 23,  !- Program Line 1
    SET CondenserLoopLoadBasedControlScheduleActuator = 1,  !- Program Line 2
    SET CondenserLoopSetpointBasedControlScheduleActuator = 0,  !- Program Line 3
    SET CondenserLoopSetpointScheduleActuator = 30.0,  !- Program Line 4
    ELSE,                    !- Program Line 5
    SET CondenserLoopLoadBasedControlScheduleActuator = 0,  !- Program Line 6
    SET CondenserLoopSetpointBasedControlScheduleActuator = 1,  !- Program Line 7
    SET CondenserLoopSetpointScheduleActuator = 20.0,  !- Program Line 8
    ENDIF;                   !- Program Line 9

