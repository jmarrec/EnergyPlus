  33.42,                   !- Latitude {deg}
  -112.02,                 !- Longitude {deg}
  -7.0,                    !- Time Zone {hr}
  339.0;                   !- Elevation {m}

!  WMO=722780 Time Zone=NAZ        (GMT-07:00) Arizona
!  Data Source=ASHRAE 2005 Annual Design Conditions
! Using Design Conditions from "Climate Design Data 2005 ASHRAE Handbook"
