! SolarShadingTest_ExternalFraction.idf
! Basic file description:  2 story building divided into 9 zones, overhangs, reveal,
!
! Highlights:              Test of shading effects for EnergyPlus.
!
! Simulation Location/Run: PHOENIX_AZ_USA_WMO_722780, 2 design days, 1 run periods.
!                          Run Control executes the run periods using the weather file
!
! Location:                Phoenix, AZ (could be anywhere)
!
! Design Days:             PHOENIX_AZ_USA Annual Heating 99.6%, MaxDB=2.9°C  (Winter design day has solar)
!                          PHOENIX_AZ_USA Annual Cooling (DB=>MWB) .4%, MaxDB=43.4°C MWB=21.1°C
!
! Run Period (Weather File): 1/1 through 12/31, PHOENIX_AZ_USA TMY2
!
! Run Control:             No Zone and System sizing.  Runs design days and weather period.
!
! Building: Fictional 9 zone building.  This building has detached shading, reveals,
!           self-shading, windows, and interzone surfaces.
!
!
! Floor Area:        780.4 m2
! Number of Stories: 2
!
! Zone Description Details:
!
!
!                       -----------         -----------         |---------|
!                       |         |         |         |         |         |
!                       |         |         |         |         |         |
!                       |         |         |         |         |         |
!            (tree) +   |         |         |         |         |         |    + (tree)
!                   +   |         |         |         |         |         |    +
!                   +   |         |---------|         |---------|         |    +
!                   +   |         |         |         |         |         |    +
!                   +   |         |         |         |         |         |    +
!                   +   |         |         |         |         |         |    +
!                   +   |         |         |         |         |         |    +
!                   +   |         |---------|         |---------|         |    +
!                   +   |         | ======= |         | ======= |         |    +
!                   +   |         |         |         |         |         |    +
!                       |         |         |         |         |         |
!                       |         |         |         |         |         |
!                       |         |         |         |         |         |
!                       |---------|         |---------|         |---------|
!                         ======              =======             =======
!  (=) overhang
!
! Internal gains description:     Infiltration uses default coefficients.
!
! Interzone Surfaces:             Yes
! Internal Mass:                  No
! People:                         None
! Lights:                         None
! Windows:                        Single Pane Windows (1/4 inch glass)
!
! Doors:                          None
!
! Detached Shading:               Yes, two trees, east and west, non-seasonal transmittance.
! Daylight:                       None
! Natural Ventilation:            None
! Compact Schedules:              Yes
! Solar Distribution:             FullInteriorAndExterior
!
! HVAC:                           Purchased Air
!
! Zonal Equipment:                None
! Central Air Handling Equipment: None
! System Equipment Autosize:      None
! Purchased Cooling:              None
! Purchased Heating:              None
! Coils:                          None
! Pumps:                          None
! Boilers:                        None
! Chillers:                       None
!
! Results:
! Standard Reports:               None
! Timestep or Hourly Variables:   Hourly and RunPeriod
! Time bins Report:               None
! HTML Report:                    None
! Environmental Emissions:        None
! Utility Tariffs:                None

Version,27.1;

Timestep,4;

Building,
  BUILDING WITH MANY SHADING EFFECTS,  !- Name
  0.0,                     !- North Axis {deg}
  Suburbs,                 !- Terrain
  0.039999999,             !- Loads Convergence Tolerance Value {W}
  0.4,                     !- Temperature Convergence Tolerance Value {deltaC}
  FullInteriorAndExterior,  !- Solar Distribution
  25,                      !- Maximum Number of Warmup Days
  6;                       !- Minimum Number of Warmup Days

SurfaceConvectionAlgorithm:Inside,TARP;

SurfaceConvectionAlgorithm:Outside,DOE-2;

SimulationControl,
  No,                      !- Do Zone Sizing Calculation
  No,                      !- Do System Sizing Calculation
  No,                      !- Do Plant Sizing Calculation
  Yes,                     !- Run Simulation for Sizing Periods
  Yes,                     !- Run Simulation for Weather File Run Periods
  No,                      !- Do HVAC Sizing Simulation for Sizing Periods
  1;                       !- Maximum Number of HVAC Sizing Simulation Passes

RunPeriod,
  Run Period 1,            !- Name
  1,                       !- Begin Month
  1,                       !- Begin Day of Month
  ,                        !- Begin Year
  12,                      !- End Month
  31,                      !- End Day of Month
  ,                        !- End Year
  Tuesday,                 !- Day of Week for Start Day
  Yes,                     !- Use Weather File Holidays and Special Days
  Yes,                     !- Use Weather File Daylight Saving Period
  No,                      !- Apply Weekend Holiday Rule
  Yes,                     !- Use Weather File Rain Indicators
  Yes;                     !- Use Weather File Snow Indicators

