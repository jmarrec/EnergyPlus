  Output:Variable,Room 102 Window,Surface Inside Face Temperature,Timestep;

  Output:Variable,Room 102 Window,Surface Outside Face Temperature,Timestep;

  Output:Variable,Room 102 Window,Surface Window Total Absorbed Shortwave Radiation Rate Layer 1,Timestep;

  Output:Variable,Room 102 Window,Surface Window Gap Convective Heat Transfer Rate,Timestep;

  Output:Variable,Room 102 Window,Surface Window Net Heat Transfer Rate,Timestep;

  Output:Variable,Room 102 Window,Surface Inside Face Net Surface Thermal Radiation Heat Gain Rate,Timestep;

  Output:Variable,Room 102 Window,Surface Inside Face Convection Heat Gain Rate,Timestep;

  Output:Variable,Room 102 Window,Surface Window Inside Face Shade Zone Convection Heat Gain Rate,Timestep;

  Output:Variable,Room 102 Window,Surface Inside Face Convection Heat Transfer Coefficient,Timestep;

  Output:Variable,*,Enclosure Windows Total Transmitted Solar Radiation Rate,Timestep;

  Output:Variable,Room 102 Window,Surface Window Heat Gain Rate,Timestep;

  Output:Variable,Room 102 Window,Surface Window Heat Loss Rate,Timestep;

  Output:Variable,*,Zone Ideal Loads Zone Total Cooling Rate,Timestep;

  Output:Variable,*,Zone Ideal Loads Zone Total Heating Rate,Timestep;

  Output:Variable,*,Surface Window Shortwave from Zone Back Out Window Heat Transfer Rate,Timestep;

  Output:Variable,*,Surface Window Inside Face Gap between Shade and Glazing Zone Convection Heat Gain Rate,Timestep;

  Output:Variable,*,Surface Window Inside Face Shade Zone Convection Heat Gain Rate,Timestep;

  Output:Variable,*,Surface Window Inside Face Shade Net Infrared Heat Transfer Rate,Timestep;

  Output:Variable,*,Surface Window Inside Face Glazing Zone Convection Heat Gain Rate,Timestep;

  Output:Variable,*,Surface Window Inside Face Glazing Net Infrared Heat Transfer Rate,Timestep;

  Output:Variable,Room 102 Window,Surface Outside Face Incident Sky Diffuse Solar Radiation Rate per Area,Timestep;

  Output:Variable,Room 102 Window,Surface Outside Face Incident Ground Diffuse Solar Radiation Rate per Area,Timestep;

  Output:Variable,Room 102 Window,Surface Outside Face Incident Beam Solar Radiation Rate per Area,Timestep;

  Output:Variable,Room 102 Window,Surface Outside Face Beam Solar Incident Angle Cosine Value,Timestep;

  Output:Variable,Room 102 Window,Surface Window BSDF Beam Direction Number,Timestep;

  Output:Diagnostics,
    DisplayAdvancedReportVariables;  !- Key 1

!       Window Material/Construction file with spectral data in IDF format
!-----------------------------------------------------
!       Window Glass Layers
!-----------------------------------------------------

  WindowMaterial:Glazing,
    Glass_103_Layer,         !- Name
    BSDF,                    !- Optical Data Type
    Glass_103_Layer_SpecDat,  !- Window Glass Spectral Data Set Name
    0.005715,                !- Thickness {m}
    ,                        !- Solar Transmittance at Normal Incidence
    ,                        !- Front Side Solar Reflectance at Normal Incidence
    ,                        !- Back Side Solar Reflectance at Normal Incidence
    ,                        !- Visible Transmittance at Normal Incidence
    ,                        !- Front Side Visible Reflectance at Normal Incidence
    ,                        !- Back Side Visible Reflectance at Normal Incidence
    0.0,                     !- Infrared Transmittance at Normal Incidence
    0.84,                    !- Front Side Infrared Hemispherical Emissivity
    0.84,                    !- Back Side Infrared Hemispherical Emissivity
    1.0,                     !- Conductivity {W/m-K}
    ,                        !- Dirt Correction Factor for Solar and Visible Transmittance
    ,                        !- Solar Diffusing
    72000000000.0,           !- Young's modulus {Pa}
    0.22;                    !- Poisson's ratio

!----------------------------------------------------------------------
!         Window Gas Layers
!----------------------------------------------------------------------

  WindowMaterial:Gas,
    Gap_1_W_0_0120,          !- Name
    Air,                     !- Gas Type
    0.012;                   !- Thickness {m}

!----------------------------------------------------------------------
!         Window Gap Layers
!----------------------------------------------------------------------

  WindowMaterial:Gap,
    Gap_1_Glz_2_Layer_1,     !- Name
    0.012,                   !- Thickness {m}
    Gap_1_W_0_0120,          !- Gas (or Gas Mixture)
    101325.0;                !- Pressure {Pa}

!----------------------------------------------------------------------
!         Thermal Model Params
!----------------------------------------------------------------------

  WindowThermalModel:Params,
    ThermParam_Glz_2,        !- Name
    ISO15099,                !- standard
    ISO15099,                !- Thermal Model
    1.0,                     !- SDScalar
    NoDeflection;            !- Deflection Model

!----------------------------------------------------------------------
!         Complex Fenestration State
!----------------------------------------------------------------------

  Construction:ComplexFenestrationState,
    CFS_Glz_2,               !- Name
    LBNLWINDOW,              !- Basis Type
    None,                    !- Basis Symmetry Type
    ThermParam_Glz_2,        !- Window Thermal Model
    CFS_Glz_2_Basis,         !- Basis Matrix Name
    CFS_Glz_2_TfSol,         !- Solar Optical Complex Front Transmittance Matrix Name
    CFS_Glz_2_RbSol,         !- Solar Optical Complex Back Reflectance Matrix Name
    CFS_Glz_2_Tfvis,         !- Visible Optical Complex Front Transmittance Matrix Name
    CFS_Glz_2_Rbvis,         !- Visible Optical Complex Back Transmittance Matrix Name
    Glass_103_Layer,         !- Outside Layer Name
    CFS_Glz_2_Layer_1_fAbs,  !- Outside Layer Directional Front Absorptance Matrix Name
    CFS_Glz_2_Layer_1_bAbs,  !- Outside Layer Directional Back Absorptance Matrix Name
    Gap_1_Glz_2_Layer_1,     !- Gap 1 Name
    ,                        !- CFS Gap 1 Directional Front Absorptance Matrix Name
    ,                        !- CFS Gap 1 Directional Back Absorptance Matrix Name
    Glass_103_Layer,         !- Layer 2 Name
    CFS_Glz_2_Layer_2_fAbs,  !- Layer 2 Directional Front Absorptance Matrix Name
    CFS_Glz_2_Layer_2_bAbs;  !- Layer 2 Directional Back Absorptance Matrix Name

!----------------------------------------------------------------------
!         Basis Matrix
!----------------------------------------------------------------------

  Matrix:TwoDimension,
    CFS_Glz_2_Basis,         !- Name
    9,                       !- Number of Rows
    2,                       !- Number of Columns
    0.0,                     !- Value 1
    1.0,                     !- Value 2
    10.0,                    !- Value 3
