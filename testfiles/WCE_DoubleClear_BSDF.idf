!-Generator IDFEditor 1.41
!-Option SortedOrder UseSpecialFormat
!-NOTE: All comments with '!-' are ignored by the IDFEditor and are generated automatically.
!-      Use '!' comments if they need to be retained when using the IDFEditor.
!-   ===========  ALL OBJECTS IN CLASS: VERSION ===========
! Approximation of the HVAC systems for the testing rooms:
!   * Single fan single duct constant air volume system.
!   * Variable chilled water flow rate with a lower limit to approximate the minimum cold air flow.
!   * Maximum supply air is higher than that of a single fan air volume in real case to better match measured cooling load.
!   * Fan efficiency and pressure rise are tuned to better match measured cooling load.
!   * Fan motor is assumed to be out of the supply air stream in order not to conteminate the cooling load with inaccurate fan motor heat gain.
!   * Added a chilled bypass to account for additional amount of chilled water designed to cool three rooms.
! Approximation of lighting:
!   * Visible absorptances of surfaces are tuned such that the workplane illuminance in the middle of room matches the measured illuminance.
! Infiltration:
!   * Infiltration air flow rate is guessed as a small value.

  Version,27.1;

!-   ===========  ALL OBJECTS IN CLASS: SIMULATIONCONTROL ===========

  SimulationControl,
    No,                      !- Do Zone Sizing Calculation
    No,                      !- Do System Sizing Calculation
    No,                      !- Do Plant Sizing Calculation
    No,                      !- Run Simulation for Sizing Periods
    Yes,                     !- Run Simulation for Weather File Run Periods
    No,                      !- Do HVAC Sizing Simulation for Sizing Periods
    1;                       !- Maximum Number of HVAC Sizing Simulation Passes

!-   ===========  ALL OBJECTS IN CLASS: BUILDING ===========

  Building,
    Building 71T Rm 102,     !- Name
    0.0,                     !- North Axis {deg}
    Suburbs,                 !- Terrain
    0.04,                    !- Loads Convergence Tolerance Value {W}
    0.4,                     !- Temperature Convergence Tolerance Value {deltaC}
    FullInteriorAndExteriorWithReflections,  !- Solar Distribution
    25,                      !- Maximum Number of Warmup Days
    6;                       !- Minimum Number of Warmup Days

!-   ===========  ALL OBJECTS IN CLASS: SHADOWCALCULATION ===========

  ShadowCalculation,
    PolygonClipping,         !- Shading Calculation Method
    Periodic,                !- Shading Calculation Update Frequency Method
    20,                      !- Shading Calculation Update Frequency
    50000;                   !- Maximum Figures in Shadow Overlap Calculations

!-   ===========  ALL OBJECTS IN CLASS: SURFACECONVECTIONALGORITHM:INSIDE ===========

  SurfaceConvectionAlgorithm:Inside,TARP;

!-   ===========  ALL OBJECTS IN CLASS: SURFACECONVECTIONALGORITHM:OUTSIDE ===========

  SurfaceConvectionAlgorithm:Outside,SimpleCombined;

!-   ===========  ALL OBJECTS IN CLASS: HEATBALANCEALGORITHM ===========

  HeatBalanceAlgorithm,ConductionTransferFunction;

!-   ===========  ALL OBJECTS IN CLASS: ZONECAPACITANCEMULTIPLIER:RESEARCHSPECIAL ===========

  ZoneCapacitanceMultiplier:ResearchSpecial,Multiplier,,1.0,1.0,1.0;

!-   ===========  ALL OBJECTS IN CLASS: TIMESTEP ===========

  Timestep,4;

