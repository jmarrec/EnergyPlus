! Cooler_1
! 4C is desired zone temperature
! max sensible load was 772,000W with ideal air (no latent included)
! Target 1.2(max) total sensible cooling capacity and DT1 of 8C
!    so unit load factor is 116,000 W/DeltaC
!    See BAC AL2s-63104, fan 7.5 HP (5595 W), airflow 51,000 cfm(24 m3/s),
!    frosted capacity 38,300 B/h-F (20,200 W/C), so need 6 of them
!  Will do Evap T of -4C, let heater = 200W,
!  Use electric defrost - capacity large to limit time and handle latent load
!  Electric defrost capacity, BAC recommends 11 W/ft2 (this model has 6,018 ft2), so 66200W
!  But that defrost capacity prooved insufficient, with excessive frost
!  accumulation -  increase defrost power to 150,000 and change schedule

Refrigeration:AirChiller,
  Cooler_1AirChiller_1,    !- Name
  AvailAllYear,            !- Availability Schedule Name
  UnitLoadFactorSensibleOnly,  !- Capacity Rating Type
  20200.0,                 !- Rated Unit Load Factor {W/K}
  ,                        !- Rated Capacity {W}
  ,                        !- Rated Relative Humidity {percent}
  -4.0,                    !- Rated Cooling Source Temperature {C}
  8.0,                     !- Rated Temperature Difference DT1 {deltaC}
  11.0,                    !- Maximum Temperature Difference Between Inlet Air and Evaporating Temperature {deltaC}
  ,                        !- Coil Material Correction Factor {dimensionless}
  ,                        !- Refrigerant Correction Factor {dimensionless}
  LinearSHR60,             !- Capacity Correction Curve Type
  ,                        !- Capacity Correction Curve Name
  1.5,                     !- SHR60 Correction Factor {dimensionless}
  200.0,                   !- Rated Total Heating Power {W}
  AirChillerDripDownSched21,  !- Heating Power Schedule Name
  ,                        !- Fan Speed Control Type
  5595.0,                  !- Rated Fan Power {W}
  24.0,                    !- Rated Air Flow {m3/s}
  ,                        !- Minimum Fan Air Flow Ratio {dimensionless}
