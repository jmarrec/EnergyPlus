!**************************************************************************************************************
!**************************************************************************************************************
! Double Clear with Woven shade on interior side
!**************************************************************************************************************
!**************************************************************************************************************
!----------------------------------------------------------------------
!         Complex Fenestration State
!----------------------------------------------------------------------

Construction:ComplexFenestrationState,
  CFS_Glz_2046,            !- Name
  LBNLWINDOW,              !- Basis Type
  None,                    !- Basis Symmetry Type
  ThermParam_2046,         !- Window Thermal Model
  CFS_Glz_2046_Basis,      !- Basis Matrix Name
  CFS_Glz_2046_TfSol,      !- Solar Optical Complex Front Transmittance Matrix Name
  CFS_Glz_2046_RbSol,      !- Solar Optical Complex Back Reflectance Matrix Name
  CFS_Glz_2046_Tfvis,      !- Visible Optical Complex Front Transmittance Matrix Name
  CFS_Glz_2046_Tbvis,      !- Visible Optical Complex Back Transmittance Matrix Name
  Glass_5012_Layer,        !- Outside Layer Name
  CFS_Glz_2046_Layer_1_fAbs,  !- Outside Layer Directional Front Absorptance Matrix Name
  CFS_Glz_2046_Layer_1_bAbs,  !- Outside Layer Directional Back Absorptance Matrix Name
  Gap_1_Layer,             !- Gap 1 Name
  ,                        !- CFS Gap 1 Directional Front Absorptance Matrix Name
  ,                        !- CFS Gap 1 Directional Back Absorptance Matrix Name
  Glass_5012_Layer,        !- Layer 2 Name
  CFS_Glz_2046_Layer_2_fAbs,  !- Layer 2 Directional Front Absorptance Matrix Name
  CFS_Glz_2046_Layer_2_bAbs,  !- Layer 2 Directional Back Absorptance Matrix Name
  Gap_1_Layer,             !- Gap 2 Name
  ,                        !- Gap 2 Directional Front Absorptance Matrix Name
  ,                        !- Gap 2 Directional Back Absorptance Matrix Name
  Shade_46_Layer,          !- Layer 3 Name
  CFS_Glz_2046_Layer_3_fAbs,  !- Layer 3 Directional Front Absorptance Matrix Name
  CFS_Glz_2046_Layer_3_bAbs;  !- Layer 3 Directional Back Absorptance Matrix Name

!----------------------------------------------------------------------
!         Thermal Model Params
!----------------------------------------------------------------------

WindowThermalModel:Params,
  ThermParam_2046,         !- Name
  ISO15099,                !- standard
  ISO15099,                !- Thermal Model
  1.0,                     !- SDScalar
  NoDeflection;            !- Deflection Model

!----------------------------------------------------------------------
!         Window Gas Layers
!----------------------------------------------------------------------

WindowMaterial:Gas,
  Gas_1_W_0_0127,          !- Name
  Air,                     !- Gas Type
  0.0127;                  !- Thickness {m}

!----------------------------------------------------------------------
!         Window Gap Layers
!----------------------------------------------------------------------
! There were two materials called "Gap_1_Layer" and this slipped through
! the input processing cracks.  Once this was fixed, this testfile failed,
! so this second instance is just commented out, which is likely what
! was occuring in the erroneous previous condition.
!
!  WindowMaterial:Gap,
!    Gap_1_Layer,             !- Name
!    0.0127,                  !- Thickness {m}
!    Gas_1_W_0_0127,          !- Gas (or Gas Mixture)
!    101325.0000;             !- Pressure {Pa}
!----------------------------------------------------------------------
!         Complex Shade
!----------------------------------------------------------------------

WindowMaterial:ComplexShade,
  Shade_46_Layer,          !- Name
  Woven,                   !- Layer Type
  0.001,                   !- Thickness {m}
  17.0,                    !- Conductivity {W/m-K}
  0.0,                     !- IR Transmittance
  0.9,                     !- Front Emissivity
  0.9,                     !- Back Emissivity
  0.0,                     !- Top Opening Multiplier
  0.0,                     !- Bottom Opening Multiplier
  0.0,                     !- Left Side Opening Multiplier
  0.0,                     !- Right Side Opening Multiplier
  0.05;                    !- Front Opening Multiplier

