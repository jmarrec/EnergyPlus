!         Basis Matrix
!----------------------------------------------------------------------

Matrix:TwoDimension,
  CFS_Glz_2046_Basis,      !- Name
  5,                       !- Number of Rows
  2,                       !- Number of Columns
  0.0,                     !- Value 1
  1.0,                     !- Value 2
