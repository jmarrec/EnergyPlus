!-   ===========  ALL OBJECTS IN CLASS: Refrigeration:WalkIn ===========
! Example of walk-in freezer in a single zone
! Tyler Refrigeration, Model LA-E Walk-in Meat Cooler,
! Date Source: Tyler Spec Sheet, SG01092, Rev. 8/93
! walk-in meat cooler dimensions at 10'(w) x 14'(L) x 9'(H) (3.05 x 4.27 x 2.74 m )
! 89 mm panels with R24.1 (U .235 W/m2-C)
! Floor is 100 mm panel with R27.4 (U .207 W/m2-C) (based on rating of 1.7 But/ft2 load at nominal ground temp of 75F)
! 12100 Btuh  estimated total load including air exchange, lighting, fans, etc.
! Smallest cooler available 16,000 Btuh  @ 25 F suction temperature
! 12100 Btuh = 3536 W,    16,000 Btuh = 4690 W
! Tyler Refrigeration, Model PFE-160M High Performance Unit Cooler
! Fan - 7.1 amps @ 115 VAC x 0.9 power factor = 734.9 W
! Lights - 2 ea. 60 W bulbs = 120 W
! Defrost - electric type, 5512 W from Tyler spec sheet
! Anti-sweat heater control type none
! Suction - 20 F (-6.67 C)
! Cooler Temp - 28 F (-2.22 C)

  Refrigeration:WalkIn,
    WalkInFreezer,           !- Name
    CaseOperatingSched,      !- Availability Schedule Name
    4690.0,                  !- Rated Coil Cooling Capacity {W}
    -2.22,                   !- Operating Temperature {C}
    -6.67,                   !- Rated Cooling Source Temperature {C}
    0.0,                     !- Rated Total Heating Power {W}
    CaseOperatingSched,      !- Heating Power Schedule Name
    735.0,                   !- Rated Cooling Coil Fan Power {W}
    0.0,                     !- Rated Circulation Fan Power {W}
    120.0,                   !- Rated Total Lighting Power {W}
    CaseLightingSched2,      !- Lighting Schedule Name
    Electric,                !- Defrost Type
    TimeSchedule,            !- Defrost Control Type
    CaseDefrostSched3,       !- Defrost Schedule Name
    CaseDripDownSched3,      !- Defrost Drip-Down Schedule Name
    5512.0,                  !- Defrost Power {W}
    ,                        !- Temperature Termination Defrost Fraction to Ice {dimensionless}
    WalkInStockingSched,     !- Restocking Schedule Name
    ,                        !- Average Refrigerant Charge Inventory {kg}
    13.0,                    !- Insulated Floor Surface Area {m2}
    0.207,                   !- Insulated Floor U-Value {W/m2-K}
    BackRoom,                !- Zone 1 Name
    43.4,                    !- Total Insulated Surface Area Facing Zone 1 {m2}
    0.235,                   !- Insulated Surface U-Value Facing Zone 1 {W/m2-K}
    ,                        !- Area of Glass Reach In Doors Facing Zone 1 {m2}
    ,                        !- Height of Glass Reach In Doors Facing Zone 1 {m}
    ,                        !- Glass Reach In Door U Value Facing Zone 1 {W/m2-K}
    ,                        !- Glass Reach In Door Opening Schedule Name Facing Zone 1
    2.0,                     !- Area of Stocking Doors Facing Zone 1 {m2}
    2.0,                     !- Height of Stocking Doors Facing Zone 1 {m}
    ,                        !- Stocking Door U Value Facing Zone 1 {W/m2-K}
